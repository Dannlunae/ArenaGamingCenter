# Supabase → Connect → "Transaction pooler" (puerto 6543)
DATABASE_URL=postgresql://postgres.xxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Tu usuario administrador: inserta antes una fila en perfiles con este uuid (rol admin)
ADMIN_ID=00000000-0000-0000-0000-000000000001
ADMIN_PASSWORD=cambia-esto
# Cadena larga aleatoria (mín. 32 caracteres)
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
